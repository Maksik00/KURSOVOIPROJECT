<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="KURSOVOIproject.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Вход"
    BackgroundColor="Black"
    Padding="20">

    <ScrollView>
        <VerticalStackLayout Spacing="20">

            <!-- Заголовок -->
            <Label
                Text="Вход"
                TextColor="White"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Поле: Телефон -->
            <Label
                Text="Телефон"
                TextColor="White"
                FontSize="16" />
            <Entry
                x:Name="PhoneEntry"
                Placeholder="Введите телефон"
                Keyboard="Telephone"
                TextColor="White"
                PlaceholderColor="#888888"
                BackgroundColor="#1E1E1E"
                HeightRequest="44" />

            <!-- Поле: Пароль -->
            <Label
                Text="Пароль"
                TextColor="White"
                FontSize="16" />
            <Entry
                x:Name="PasswordEntry"
                Placeholder="Введите пароль"
                IsPassword="True"
                TextColor="White"
                PlaceholderColor="#888888"
                BackgroundColor="#1E1E1E"
                HeightRequest="44" />

            <!-- Кнопка: Войти -->
            <Button
                Text="Войти"
                BackgroundColor="#007AFF"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="45"
                Clicked="OnLoginButtonClicked" />

            <!-- Ссылка: Регистрация -->
            <Label
                Text="Нет аккаунта? Зарегистрироваться"
                TextColor="#007AFF"
                HorizontalOptions="Center"
                FontAttributes="Bold">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegisterTapped" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
