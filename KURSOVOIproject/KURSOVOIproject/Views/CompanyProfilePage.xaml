<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KURSOVOIproject.Views.CompanyProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Профиль компании"
    BackgroundColor="Black"
    Padding="20">

    <ScrollView>
        <VerticalStackLayout Spacing="25">

            <!-- 1) Название компании + Логотип (Placeholder) -->
            <HorizontalStackLayout VerticalOptions="Center" Spacing="15">
                <Frame
                    WidthRequest="70"
                    HeightRequest="70"
                    CornerRadius="35"
                    BackgroundColor="#888888">
                    <Label
                        Text="{Binding Name, Mode=OneWay}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        TextColor="White"
                        FontSize="28"
                        FontAttributes="Bold" />
                </Frame>
                <VerticalStackLayout Spacing="2">
                    <Label
                        Text="{Binding Name, Mode=OneWay}"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold" />
                    <Label
                        Text="Компания"
                        TextColor="#BBBBBB"
                        FontSize="14"
                        FontAttributes="Italic" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- 2) Кнопка “Редактировать” -->
            <Button
                Text="Редактировать профиль"
                BackgroundColor="#007AFF"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="45"
                Clicked="OnEditProfileClicked" />

            <!-- 3) Кнопка “Создать стажировку” -->
            <Button
                Text="Создать новую стажировку"
                BackgroundColor="#28A745"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="45"
                Clicked="OnCreateInternshipClicked" />

            <!-- 4) Кнопка “Выйти” -->
            <Button
                Text="Выйти"
                BackgroundColor="Transparent"
                BorderColor="#FF3B30"
                TextColor="#FF3B30"
                CornerRadius="8"
                HeightRequest="45"
                Clicked="OnLogoutClicked" />

            <!-- 5) Блок с информацией о компании -->
            <Frame
                BackgroundColor="#1E1E1E"
                CornerRadius="12"
                Padding="15"
                HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Город"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding City, Mode=OneWay}"
                        TextColor="White"
                        FontSize="16" />

                    <Label
                        Text="Улица"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding Street, Mode=OneWay}"
                        TextColor="White"
                        FontSize="16" />

                    <Label
                        Text="Дом/Корпус"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding Building, Mode=OneWay}"
                        TextColor="White"
                        FontSize="16" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
