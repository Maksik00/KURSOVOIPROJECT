<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KURSOVOIproject.Views.ResponsesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Мои отклики">

    <StackLayout Padding="10">
        <!-- 1) Сегментированный контрол, который показывает:
         - тикет «Ожидают решения»,
         - тикет «Одобрены»,
         - тикет «Отклонены» -->
        <!-- TODO: добавить SegmentedControl или кнопки для фильтрации по статусу -->

        <!-- 2) CollectionView для списка откликов студента -->
        <CollectionView x:Name="ResponsesCollection"
                    ItemsSource="{Binding Responses}"
                    IsRefreshing="{Binding IsBusy}"
                    Margin="0,20,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
              Padding="10"
              Margin="0,5"
              CornerRadius="10"
              BackgroundColor="#1E1E1E">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <!-- Название стажировки -->
                            <Label Text="{Binding InternshipTitle}"
                     FontAttributes="Bold"
                     TextColor="White" />

                            <!-- Статус отклика -->
                            <Label Text="{Binding Status}"
                     TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                     FontSize="12"
                     Grid.Row="1"
                     Margin="0,5,0,0" />

                            <!-- Кнопка «Написать сообщение» -->
                            <Button Text="Написать сообщение"
                      Grid.Row="2"
                      IsEnabled="{Binding Status, Converter={StaticResource StatusToBoolConverter}}"
                      Clicked="OnMessageStudentClicked" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
