<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KURSOVOIproject.Views.CompanyLoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Вход для компаний"
    BackgroundColor="Black"
    Padding="20">

    <ScrollView>
        <VerticalStackLayout Spacing="20">

            <!-- Поле: Название компании -->
            <Label
                Text="Название компании"
                TextColor="White"
                FontSize="16" />
            <Entry
                x:Name="NameEntry"
                Placeholder="Введите название"
                TextColor="White"
                PlaceholderColor="#888888"
                BackgroundColor="#1E1E1E"
                HeightRequest="44"
                Keyboard="Text" />

            <!-- Поле: Пароль -->
            <Label
                Text="Пароль"
                TextColor="White"
                FontSize="16" />
            <Entry
                x:Name="PasswordEntry"
                Placeholder="Введите пароль"
                IsPassword="True"
                TextColor="White"
                PlaceholderColor="#888888"
                BackgroundColor="#1E1E1E"
                HeightRequest="44"
                Keyboard="Text" />

            <!-- Кнопка: Войти -->
            <Button
                Text="Войти"
                BackgroundColor="#007AFF"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="45"
                Clicked="OnLoginButtonClicked" />

            <!-- Кнопка: Новая компания? Регистрация -->
            <Button
                Text="Я новая компания. Регистрация"
                BackgroundColor="Transparent"
                BorderColor="#007AFF"
                TextColor="#007AFF"
                CornerRadius="8"
                HeightRequest="45"
                Clicked="OnRegisterTapped" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
