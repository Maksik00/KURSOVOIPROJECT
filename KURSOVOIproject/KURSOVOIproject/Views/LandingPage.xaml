<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KURSOVOIproject.Views.LandingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="SFL"
    BackgroundColor="Black">

    <Grid RowDefinitions="*, Auto, Auto, 30">
        <!-- Логотип «S» посередине -->
        <StackLayout Grid.Row="0"
                 VerticalOptions="Center"
                 HorizontalOptions="Center"
                 Spacing="20">
            <Frame WidthRequest="80"
             HeightRequest="80"
             BackgroundColor="Red"
             CornerRadius="8"
             HasShadow="False"
             VerticalOptions="Center"
             HorizontalOptions="Center">
                <Label Text="S"
               TextColor="White"
               FontSize="60"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
            </Frame>

            <Label Text="Работа мечты в твоем кармане"
             TextColor="White"
             FontSize="24"
             HorizontalOptions="Center"
             HorizontalTextAlignment="Center" />
        </StackLayout>

        <!-- Кнопка «Я новый пользователь» -->
        <Button
      Grid.Row="1"
      Text="Я новый пользователь"
      BackgroundColor="#00BFFF"
      TextColor="White"
      CornerRadius="8"
      HeightRequest="50"
      Margin="20,10,20,0"
      Clicked="OnRegisterButtonClicked" />

        <!-- Кнопка «У меня есть аккаунт. Войти» -->
        <Button
      Grid.Row="2"
      Text="У меня есть аккаунт. Войти"
      BackgroundColor="Transparent"
      BorderColor="#00BFFF"
      BorderWidth="2"
      TextColor="#00BFFF"
      CornerRadius="8"
      HeightRequest="50"
      Margin="20,10,20,20"
      Clicked="OnLoginButtonClicked" />
    </Grid>
</ContentPage>
