<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KURSOVOIproject.Views.RegistrationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Регистрация"
    BackgroundColor="Black">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Entry
        x:Name="NameEntry"
        Placeholder="Имя"
        TextColor="White"
        PlaceholderColor="Gray" />

            <Entry
        x:Name="PhoneEntry"
        Placeholder="Телефон (+7…)"
        Keyboard="Telephone"
        TextColor="White"
        PlaceholderColor="Gray" />

            <Entry
        x:Name="CourseEntry"
        Placeholder="Курс (число)"
        Keyboard="Numeric"
        TextColor="White"
        PlaceholderColor="Gray" />

            <Picker
        x:Name="SpecPicker"
        Title="Выберите специализацию"
        TextColor="White"
        TitleColor="Gray" />

            <Entry
        x:Name="PasswordEntry"
        Placeholder="Пароль"
        IsPassword="True"
        TextColor="White"
        PlaceholderColor="Gray" />

            <Button
        Text="Зарегистрироваться"
        BackgroundColor="#007ACC"
        TextColor="White"
        CornerRadius="8"
        HeightRequest="50"
        Clicked="OnRegisterButtonClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
