<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KURSOVOIproject.Views.StudentProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Профиль студента"
    BackgroundColor="Black"
    Padding="20">

    <ScrollView>
        <VerticalStackLayout Spacing="20">

            <!-- 1) Аватарка + Имя + Роль -->
            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                <Frame
                    WidthRequest="70"
                    HeightRequest="70"
                    CornerRadius="35"
                    BackgroundColor="#888888">
                    <!-- Здесь можно подставить фотографию студента -->
                    <Label
                        Text="{Binding Name[0]}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        TextColor="White"
                        FontSize="28"
                        FontAttributes="Bold" />
                </Frame>
                <VerticalStackLayout Spacing="2">
                    <Label
                        Text="{Binding Name}"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold" />
                    <Label
                        Text="Студент"
                        TextColor="#BBBBBB"
                        FontSize="14"
                        FontAttributes="Italic" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- 2) Кнопка “Редактировать” -->
            <Button
                Text="Редактировать профиль"
                BackgroundColor="#007AFF"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="45"
                Clicked="OnEditProfileClicked" />

            <!-- 3) Кнопка “Выйти” -->
            <Button
                Text="Выйти"
                BackgroundColor="Transparent"
                BorderColor="#FF3B30"
                TextColor="#FF3B30"
                CornerRadius="8"
                HeightRequest="45"
                Clicked="OnLogoutClicked" />

            <!-- 4) Блок “Контакт” -->
            <Frame
                BackgroundColor="#1E1E1E"
                CornerRadius="12"
                Padding="15"
                HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Телефон"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding TelNumber}"
                        TextColor="White"
                        FontSize="16" />
                </VerticalStackLayout>
            </Frame>

            <!-- 5) Блок “Курс / Специальность” -->
            <Frame
                BackgroundColor="#1E1E1E"
                CornerRadius="12"
                Padding="15"
                HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Курс"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding Course}"
                        TextColor="White"
                        FontSize="16" />

                    <Label
                        Text="Специальность"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding Specialization.Name}"
                        TextColor="White"
                        FontSize="16" />
                </VerticalStackLayout>
            </Frame>

            <!-- 6) Блок “Навыки” -->
            <Frame
                BackgroundColor="#1E1E1E"
                CornerRadius="12"
                Padding="15"
                HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Навыки"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding SkillsDisplay}"
                        TextColor="White"
                        FontSize="16" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
