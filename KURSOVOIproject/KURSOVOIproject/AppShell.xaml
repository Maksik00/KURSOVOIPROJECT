<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="KURSOVOIproject.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KURSOVOIproject.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="SFL">

    <!-- 
    1) LandingPage – скрытая страница, но мы сделаем её «первым ShellContent»
    2) Все остальные (LoginPage, RegistrationPage, SearchPage) также регистрируем для навигации 
  -->

    <!-- LandingPage, будет открыт сразу при запуске -->
    <ShellContent
      Route="LandingPage"
      ContentTemplate="{DataTemplate views:LandingPage}"
      IsVisible="False" />

    <!-- LoginPage -->
    <ShellContent
      Route="LoginPage"
      ContentTemplate="{DataTemplate views:LoginPage}"
      IsVisible="False" />

    <!-- RegistrationPage -->
    <ShellContent
      Route="RegistrationPage"
      ContentTemplate="{DataTemplate views:RegistrationPage}"
      IsVisible="False" />

    <!-- SearchPage -->
    <ShellContent
      Route="SearchPage"
      ContentTemplate="{DataTemplate views:SearchPage}"
      IsVisible="False" />

    <!-- 
    TabBar с видимыми вкладками для «основного» интерфейса.
    Пока что в примере – только одна вкладка SearchPage. Другие можно добавить позднее.
  -->
    <TabBar>
        <ShellContent
        Title="Поиск"
        Icon="icon_search.png"
        Route="SearchPage"
        ContentTemplate="{DataTemplate views:SearchPage}" />
        <!-- позже сюда добавим: FavoritesPage, ApplicationsPage, MessagesPage, ProfilePage -->
    </TabBar>
</Shell>
